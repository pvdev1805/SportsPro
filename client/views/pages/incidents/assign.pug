extends ../../layouts/default.pug

block content
  .main-panel
    .header-section
      h2 Assign Incident
      a.btn.btn-home(href="/incidents") Back to Incidents

    #incident-assign-error.alert.alert-danger(
      role="alert"
      aria-live="polite"
      hidden
    )

    .incidents-panel.mb-4
      h3 Select Incident

      p#assign-empty-message(hidden) No assignable incidents found.

      .table-container
        table#assign-incidents-table(hidden)
          thead
            tr
              th ID
              th Customer
              th Product
              th Status
              th Technician
              th Date Opened
              th Title
              th Action

          tbody#assign-incidents-body

    #assignment-panel.assignment-panel(hidden)
      h3 Assign to Technician

      .incident-details.mb-4
        .detail-row
          .detail-label Incident ID:
          .detail-value#selected-incident-id

        .detail-row
          .detail-label Customer:
          .detail-value#selected-customer

        .detail-row
          .detail-label Product:
          .detail-value#selected-product

        .detail-row
          .detail-label Current Status:
          .detail-value#selected-status

        .detail-row
          .detail-label Current Technician:
          .detail-value#selected-technician

        .detail-row
          .detail-label Title:
          .detail-value#selected-title

      form#incident-assignment-form
        .form-group
          label(for="techId") Technician

          select#techId(
            name="techId"
            required
          )
            option(value="") -- Select a Technician --

        .button-group
          button#assign-submit.btn.btn-primary(
            type="submit"
          ) Assign Incident

          button#assign-cancel.btn.btn-secondary(
            type="button"
          ) Cancel

block scripts
  script(
    src="/js/incident-assign.js"
    type="module"
  )
