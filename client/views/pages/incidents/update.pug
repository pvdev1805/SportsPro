extends ../../layouts/default.pug

block content
  .main-panel
    .header-section
      h2#incident-update-title Incident Details
      a.btn.btn-home(href="/incidents") Back to Incidents

    #incident-update-error.alert.alert-danger(
      role="alert"
      aria-live="polite"
      hidden
    )

    #incident-loading
      p Loading incident...

    #incident-content(hidden)
      .incident-details-panel.mb-4
        h3 Incident Information

        .incident-details
          .detail-row
            .detail-label Incident ID:
            .detail-value#incident-id

          .detail-row
            .detail-label Customer:
            .detail-value#incident-customer

          .detail-row
            .detail-label Technician:
            .detail-value#incident-technician

          .detail-row
            .detail-label Status:
            .detail-value#incident-status

          .detail-row
            .detail-label Date Opened:
            .detail-value#incident-date-opened

          .detail-row
            .detail-label Date Closed:
            .detail-value#incident-date-closed

      .update-panel
        h3#incident-form-title Update Incident

        form#incident-update-form(novalidate)
          .form-group
            label(for="productCode") Product:
            select#productCode(
              name="productCode"
              required
            )
              option(value="") Loading products...

          .form-group
            label(for="title") Title:
            input#title(
              name="title"
              type="text"
              required
            )

          .form-group
            label(for="description") Description:
            textarea#description(
              name="description"
              rows="6"
              required
            )

          #content-update-actions.button-group
            button#save-incident-button.btn.btn-primary(
              type="submit"
            ) Save Changes

      #status-panel.update-panel.mt-4(hidden)
        h3 Incident Status

        p#status-description.mb-3

        button#status-update-button.btn.btn-primary(
          type="button"
        )

block scripts
  script(
    src="/js/incident-update.js"
    type="module"
  )
