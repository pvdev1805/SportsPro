extends ../../layouts/default.pug

block content
  .main-panel
    .header-section
      h2 Create Incident
      a.btn.btn-home(href="/incidents") Back to Incidents

    #incident-create-error.alert.alert-danger(
      role="alert"
      aria-live="polite"
      hidden
    )

    .form-panel
      form#incident-create-form
        #customer-field.form-group(hidden)
          label(for="customerId") Customer
          select#customerId(name="customerId")
            option(value="") Loading customers...

        .form-group
          label(for="productCode") Product
          select#productCode(
            name="productCode"
            required
          )
            option(value="") Loading products...

        .form-group
          label(for="title") Title
          input#title(
            type="text"
            name="title"
            placeholder="Brief description of the issue"
            required
          )

        .form-group
          label(for="description") Description
          textarea#description(
            name="description"
            rows="5"
            placeholder="Detailed description of the incident"
            required
          )

        .button-group
          button#incident-create-submit.btn.btn-primary(
            type="submit"
          ) Create Incident

          a.btn.btn-secondary(
            href="/incidents"
          ) Cancel

block scripts
  script(
    src="/js/incident-create.js"
    type="module"
  )
