extends ../../layouts/default.pug

block content
  .main-panel
    .header-section
      h2#incidents-page-title Incidents

      .button-group
        a#incident-create-link.btn.btn-primary(
          href="/incidents/create"
          hidden
        ) Create Incident

        a#incident-assign-link.btn.btn-secondary(
          href="/incidents/assign"
          hidden
        ) Assign Incident

        a.btn.btn-home(href="/") Home

    #incidents-error.alert.alert-danger(
      role="alert"
      aria-live="polite"
      hidden
    )

    .incidents-panel.mb-4
      h3 Incident List

      p#incidents-empty(hidden) No incidents found.

      .table-container
        table#incidents-table(hidden)
          thead
            tr
              th ID
              th Customer
              th Product
              th Technician
              th Status
              th Date Opened
              th Date Closed
              th Title
              th Action

          tbody#incidents-table-body

block scripts
  script(
    src="/js/incidents.js"
    type="module"
  )
