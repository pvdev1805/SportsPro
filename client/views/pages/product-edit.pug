extends ../layouts/default.pug

block content
  .main-panel
    .form-panel
      h3 Edit Product

      #product-edit-error.alert.alert-danger(
        role="alert"
        hidden
      )

      form#product-edit-form
        .form-group
          label(for="name") Name
          input#name(
            type="text"
            name="name"
            required
          )

        .form-group
          label(for="version") Version
          input#version(
            type="number"
            name="version"
            step="0.1"
            min="0.1"
            required
          )

        .form-group
          label(for="releaseDate") Release Date
          input#releaseDate(
            type="date"
            name="releaseDate"
            required
          )

        .button-group
          button.btn.btn-primary(
            type="submit"
          ) Save Changes

          a.btn.btn-secondary(
            href="/products"
          ) Cancel

block scripts
  script(
    src="/js/product-edit.js"
    type="module"
  )
