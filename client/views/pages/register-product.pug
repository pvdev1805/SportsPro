extends ../layouts/default.pug

block content
  .main-panel.small-panel
    .header-section
      h2 Register Product
      a.btn.btn-home(href="/") Home

    #registration-error.alert.alert-danger(
      role="alert"
      aria-live="polite"
      hidden
    )

    .registration-panel
      .customer-info.mb-3
        p
          strong Customer:
          |
          span#customer-name Loading...

      form#product-registration-form
        .form-group
          label(for="productCode") Product:

          select#productCode(
            name="productCode"
            required
          )
            option(value="") Loading products...

        button.btn.btn-primary.full-width(
          type="submit"
        ) Register Product

    #registration-success.success-panel(
      hidden
    )
      .alert.alert-success
        p#registration-success-message Product registered successfully.

      button#register-another-btn.btn.btn-primary.full-width(
        type="button"
      ) Register Another Product

block scripts
  script(
    src="/js/product-registration.js"
    type="module"
  )
