extends ../layouts/default.pug

block content
  .main-panel
    .form-panel
      h3 Edit Technician

      #technician-edit-error.alert.alert-danger(
        role="alert"
        hidden
      )

      form#technician-edit-form(novalidate)
        .form-group
          label(for="firstName") First Name
          input#firstName(
            type="text"
            name="firstName"
            maxlength="50"
            required
          )

        .form-group
          label(for="lastName") Last Name
          input#lastName(
            type="text"
            name="lastName"
            maxlength="50"
            required
          )

        .form-group
          label(for="email") Email
          input#email(
            type="email"
            name="email"
            maxlength="100"
            required
          )

        .form-group
          label(for="phone") Phone
          input#phone(
            type="tel"
            name="phone"
            maxlength="20"
            required
          )

        .button-group
          button.btn.btn-primary(
            type="submit"
          ) Save Changes

          a.btn.btn-secondary(
            href="/technicians"
          ) Cancel

block scripts
  script(
    src="/js/technician-edit.js"
    type="module"
  )
