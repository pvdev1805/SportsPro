extends ../layouts/default

block content
  .main-panel
    .form-panel
      h3 Create Account

      form#register-form(novalidate)
        .form-group
          label(for='firstName') First Name
          input#firstName(
            type='text'
            name='firstName'
            autocomplete='given-name'
            required
          )

        .form-group
          label(for='lastName') Last Name
          input#lastName(
            type='text'
            name='lastName'
            autocomplete='family-name'
            required
          )

        .form-group
          label(for='email') Email
          input#email(
            type='email'
            name='email'
            autocomplete='email'
            required
          )

        .form-group
          label(for='password') Password
          input#password(
            type='password'
            name='password'
            autocomplete='new-password'
            required
          )

        .form-group
          label(for='address') Address
          input#address(
            type='text'
            name='address'
            autocomplete='street-address'
            required
          )

        .form-group
          label(for='city') City
          input#city(
            type='text'
            name='city'
            autocomplete='address-level2'
            required
          )

        .form-group
          label(for='state') State
          input#state(
            type='text'
            name='state'
            autocomplete='address-level1'
            required
          )

        .form-group
          label(for='postalCode') Postal Code
          input#postalCode(
            type='text'
            name='postalCode'
            autocomplete='postal-code'
            required
          )

        .form-group
          label(for='countryCode') Country Code
          input#countryCode(
            type='text'
            name='countryCode'
            maxlength='2'
            placeholder='AU'
            required
          )

        .form-group
          label(for='phone') Phone
          input#phone(
            type='tel'
            name='phone'
            autocomplete='tel'
            required
          )

        #register-error(
          role='alert'
          aria-live='polite'
          hidden
        )

        button#register-submit(type='submit') Create Account

      p
        | Already have an account?
        a(href='/login') Sign In

block scripts
  script(type='module' src='/js/pages/register.js')
