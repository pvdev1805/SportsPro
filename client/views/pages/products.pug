extends ../layouts/default.pug

block content
  .main-panel
    .header-section
      h2 Product List

      .button-group
        a#add-product-link.btn.btn-primary(
          href="/products/create"
          hidden
        ) Add Product

        a.btn.btn-home(href="/") Home

    #products-error.alert.alert-danger(
      role="alert"
      hidden
    )

    .table-container.mb-4
      table#products-table(hidden)
        thead
          tr
            th Code
            th Name
            th Version
            th Release Date
            th#product-actions-header(hidden) Action

        tbody#products-table-body

block scripts
  script(
    src="/js/products.js"
    type="module"
  )
