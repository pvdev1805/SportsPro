extends ../layouts/default.pug

block content
  .main-panel
    h2 SportsPro Technical Support

    #home-error.alert.alert-danger(
      role="alert"
      aria-live="polite"
      hidden
    )

    #guest-home.hidden
      h3 Welcome
      p Please sign in or create an account to access SportsPro Technical Support.

      .button-group
        a.btn.btn-primary(href="/login") Sign In
        a.btn.btn-secondary(href="/register") Create Account

    #authenticated-home.hidden
      p#home-welcome-message

      .menu-section
        h3#home-role-title

        ul#home-menu-list.menu-list

block scripts
  script(
    src="/js/pages/home.js"
    type="module"
  )
