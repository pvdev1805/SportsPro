extends ../layouts/default.pug

block content
  .main-panel
    .form-panel
      h3 View/Update Customer

      #customer-edit-error.alert.alert-danger(
        role="alert"
        hidden
      )

      form#customer-edit-form(novalidate)
        .form-row
          .form-group
            label(for="firstName") First Name
            input#firstName(
              type="text"
              name="firstName"
              maxlength="50"
              required
            )

          .form-group
            label(for="lastName") Last Name
            input#lastName(
              type="text"
              name="lastName"
              maxlength="50"
              required
            )

        .form-group
          label(for="email") Email
          input#email(
            type="email"
            name="email"
            maxlength="100"
            required
          )

        .form-group
          label(for="address") Address
          input#address(
            type="text"
            name="address"
            maxlength="50"
            required
          )

        .form-row
          .form-group
            label(for="city") City
            input#city(
              type="text"
              name="city"
              maxlength="50"
              required
            )

          .form-group
            label(for="state") State
            input#state(
              type="text"
              name="state"
              maxlength="50"
              required
            )

        .form-row
          .form-group
            label(for="postalCode") Postal Code
            input#postalCode(
              type="text"
              name="postalCode"
              maxlength="20"
              required
            )

          .form-group
            label(for="countryCode") Country Code
            input#countryCode(
              type="text"
              name="countryCode"
              minlength="2"
              maxlength="2"
              required
            )

        .form-group
          label(for="phone") Phone
          input#phone(
            type="tel"
            name="phone"
            maxlength="20"
            required
          )

        .button-group
          button.btn.btn-primary(
            type="submit"
          ) Save Changes

          a.btn.btn-secondary(
            href="/customers"
          ) Cancel

block scripts
  script(
    src="/js/customer-edit.js"
    type="module"
  )
