extends ../layouts/default.pug

block content
  .main-panel
    .header-section
      h2 Technician List

      .button-group
        a.btn.btn-primary(href="/technicians/create") Add Technician
        a.btn.btn-home(href="/") Home

    #technicians-error.alert.alert-danger(
      role="alert"
      hidden
    )

    .table-container.mb-4
      table
        thead
          tr
            th First Name
            th Last Name
            th Email
            th Phone
            th Status
            th Action

        tbody#technicians-table-body

block scripts
  script(src="/js/technicians.js" type="module")
